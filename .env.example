# pnpm dev:infra && pnpm setup:local generates local credentials and signing keys.
APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
API_PORT=4100
API_HOST=127.0.0.1
ARTIFACT_ROOT=./work/artifacts
PACKAGE_SIGNING_KEY_FILE=./work/keys/private.pem
PACKAGE_PUBLIC_KEY_FILE=./work/keys/public.pem
OPENROUTER_API_KEY=
OPENROUTER_CODING_MODEL=openai/gpt-6.1-sol
OPENROUTER_MODERATION_MODEL=typesafe/jev-1.13
OPENROUTER_REASONING_EFFORT=high
OPENROUTER_MAX_OUTPUT_TOKENS=16384
OPENROUTER_IMAGE_MODEL=meta/muse-image
OPENROUTER_MAX_JOB_COST_USD=10
OPENROUTER_MAX_DAILY_COST_USD=100
# Protective limits are enabled for new installations. Review caps before funding a provider key.
GENERATION_DAILY_LIMIT_ENABLED=true
MODIFICATION_DAILY_LIMIT_ENABLED=true
GENERATION_CONCURRENT_LIMIT_ENABLED=true
OPENROUTER_JOB_COST_LIMIT_ENABLED=true
OPENROUTER_DAILY_COST_LIMIT_ENABLED=true
API_RATE_LIMIT_ENABLED=true
APP_INTEGRITY_CHALLENGE_LIMIT_ENABLED=true
OPENROUTER_ESTIMATED_COST_ENABLED=true
GENERATION_DAILY_LIMIT=5
GENERATION_CREDITS_ENABLED=true
MODIFICATION_DAILY_LIMIT=5
GENERATION_TIMEOUT_SECONDS=1800
GENERATION_REPAIR_LIMIT=3
GENERATION_CONCURRENCY=1
GATEWAY_PORT=4101
SANDBOX_IMAGE=ai-games-sandbox:1
EXPO_PUBLIC_API_URL=http://127.0.0.1:4100
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_PACKAGE_SIGNING_KEY=

# PostHog ingestion key (phc_), shared by API/worker and the host mobile app.
# An empty key disables analytics. Test runners explicitly disable live telemetry.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=false
ANALYTICS_ENVIRONMENT=development
APP_RELEASE=0.1.0
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_ENABLED=false
EXPO_PUBLIC_ANALYTICS_ENVIRONMENT=development
EXPO_PUBLIC_APP_RELEASE=0.1.0
# Build/management credentials are private; never EXPO_PUBLIC or app extras.
POSTHOG_CLI_HOST=https://us.posthog.com
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_API_KEY=
POSTHOG_UPLOAD_SOURCEMAPS=false

# Production defaults require app attestation. This sample explicitly enables local fixtures.
APP_INTEGRITY_MODE=local-development
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.aigames.creator.dev
APPLE_APP_ATTEST_ENVIRONMENT=development
ANDROID_PACKAGE_NAME=com.aigames.creator.dev
# Comma-separated base64url SHA256 digests of Play App Signing certificates.
ANDROID_CERTIFICATE_SHA256_DIGESTS=
# Google ADC/service-account credentials stay server-side via GOOGLE_APPLICATION_CREDENTIALS.
EXPO_PUBLIC_APP_INTEGRITY_MODE=local-development
EXPO_PUBLIC_PLAY_INTEGRITY_PROJECT_NUMBER=
