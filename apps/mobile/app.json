{
  "expo": {
    "name": "AI Games",
    "slug": "ai-games",
    "scheme": "aigames",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.aigames.creator",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.aigames.creator",
      "permissions": []
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-sqlite", "expo-asset", "expo-font"],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
