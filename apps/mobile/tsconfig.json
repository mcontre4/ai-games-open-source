{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/domain/**/*.ts",
    "../../packages/contracts/**/*.ts",
    "../../packages/application/**/*.ts",
    "../../packages/game-sdk/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
