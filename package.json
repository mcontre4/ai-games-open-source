{
  "name": "ai-games",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:infra": "tsx scripts/start-infra.ts",
    "stop:infra": "supabase stop --workdir infrastructure",
    "setup:local": "tsx scripts/setup-local.ts",
    "db:migrate": "pnpm db:migrate:dev",
    "dev:api": "tsx scripts/run.ts development api",
    "dev:worker": "tsx scripts/run.ts development worker",
    "dev:mobile": "tsx scripts/run.ts development mobile",
    "ios": "tsx scripts/run.ts development ios",
    "android": "tsx scripts/run.ts development android",
    "fixture:build": "vite build --config packages/game-template/vite.config.ts",
    "fixture:seed": "tsx scripts/run.ts development seed",
    "sandbox:build": "docker build -f infrastructure/sandbox/Dockerfile -t ai-games-sandbox:1 .",
    "typecheck": "tsc --noEmit && pnpm --filter @ai-games/mobile typecheck",
    "lint": "eslint apps packages scripts tests && tsx scripts/check-boundaries.ts",
    "test": "vitest run tests/unit tests/security",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "test:mobile": "maestro test tests/mobile",
    "test:generation:live": "tsx scripts/run.ts development live",
    "test:moderation:live": "tsx scripts/run.ts development moderation",
    "build": "pnpm fixture:build && pnpm typecheck && pnpm build:dev",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm test:e2e",
    "prepare": "node scripts/install-hooks.mjs",
    "analytics:configure": "tsx scripts/setup-posthog.ts development",
    "analytics:preview": "tsx scripts/setup-posthog.ts development --preview",
    "dev": "tsx scripts/run.ts development all",
    "prod": "tsx scripts/run.ts production mobile",
    "prod:api": "tsx scripts/run.ts production api",
    "prod:worker": "tsx scripts/run.ts production worker",
    "prod:server": "tsx scripts/run.ts production server",
    "prod:mobile": "tsx scripts/run.ts production mobile",
    "dev:ios": "tsx scripts/run.ts development mobile --ios --localhost --port 8084",
    "dev:android": "tsx scripts/run.ts development mobile --android --localhost --port 8084",
    "prod:ios": "tsx scripts/run.ts production ios --configuration Release",
    "prod:android": "tsx scripts/run.ts production android --variant release",
    "db:migrate:dev": "tsx scripts/run.ts development migrate",
    "db:migrate:prod": "tsx scripts/run.ts production migrate",
    "build:dev": "tsx scripts/run.ts development export",
    "build:prod": "tsx scripts/run.ts production export",
    "analytics:configure:prod": "tsx scripts/setup-posthog.ts production",
    "analytics:preview:prod": "tsx scripts/setup-posthog.ts production --preview",
    "secrets:check": "gitleaks git . --redact=100 --log-opts=--all",
    "screenshots": "playwright test --config playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@supabase/supabase-js": "2.117.3",
    "cbor": "10.0.12",
    "fastify": "5.12.5",
    "fflate": "0.8.2",
    "google-auth-library": "10.5.0",
    "jose": "6.1.3",
    "node-app-attest": "1.0.1",
    "pg": "8.16.3",
    "pg-boss": "12.37.1",
    "phaser": "3.90.0",
    "posthog-node": "^5.55.1",
    "sharp": "0.34.5",
    "three": "0.180.0",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@posthog/cli": "^0.18.10",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/three": "0.180.0",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "supabase": "2.109.0",
    "tsx": "4.21.0",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "description": "Create, modify and play signed offline games with an Expo app and self-hosted AI generation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcontre4/ai-games-open-source.git"
  },
  "bugs": {
    "url": "https://github.com/mcontre4/ai-games-open-source/issues"
  },
  "homepage": "https://github.com/mcontre4/ai-games-open-source#readme"
}
