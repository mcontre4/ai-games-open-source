# Server-only template. Copy to .env.production on your server, mode 0600.
# Supply independent credentials; never copy the development .env or signing keys.
APP_ENV=production
# Configure Apple/Google attestation before exposing your deployment.
APP_INTEGRITY_MODE=required
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.aigames.creator
APPLE_APP_ATTEST_ENVIRONMENT=production
ANDROID_PACKAGE_NAME=com.aigames.creator
ANDROID_CERTIFICATE_SHA256_DIGESTS=
# Google Play Integrity uses server-only Application Default Credentials.
DATABASE_URL=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
API_HOST=127.0.0.1
API_PORT=4100
ARTIFACT_ROOT=/srv/ai-games-data/artifacts
PACKAGE_SIGNING_KEY_FILE=/srv/ai-games-data/keys/private.pem
PACKAGE_PUBLIC_KEY_FILE=/srv/ai-games-data/keys/public.pem
OPENROUTER_API_KEY=
OPENROUTER_CODING_MODEL=openai/gpt-6.1-sol
OPENROUTER_MODERATION_MODEL=typesafe/jev-1.13
OPENROUTER_IMAGE_MODEL=meta/muse-image
OPENROUTER_REASONING_EFFORT=high
OPENROUTER_MAX_JOB_COST_USD=10
OPENROUTER_MAX_DAILY_COST_USD=100
# Protective limits are enabled for new installations. Review caps before funding a provider key.
GENERATION_DAILY_LIMIT_ENABLED=true
MODIFICATION_DAILY_LIMIT_ENABLED=true
GENERATION_CONCURRENT_LIMIT_ENABLED=true
OPENROUTER_JOB_COST_LIMIT_ENABLED=true
OPENROUTER_DAILY_COST_LIMIT_ENABLED=true
API_RATE_LIMIT_ENABLED=true
APP_INTEGRITY_CHALLENGE_LIMIT_ENABLED=true
OPENROUTER_ESTIMATED_COST_ENABLED=true
GENERATION_TIMEOUT_SECONDS=1800
GENERATION_CREDITS_ENABLED=true
GATEWAY_PORT=4101
SANDBOX_IMAGE=ai-games-sandbox:1
ANALYTICS_ENVIRONMENT=production
APP_RELEASE=0.1.0
POSTHOG_API_KEY=
POSTHOG_ENABLED=false
