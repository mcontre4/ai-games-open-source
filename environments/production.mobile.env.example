# Public mobile settings for YOUR deployment. This template has no working keys.
# Copy to apps/mobile/.env.production (ignored) and fill every required value.
# For EAS, set the same public values in your project's production environment.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_APP_INTEGRITY_MODE=required
EXPO_PUBLIC_PLAY_INTEGRITY_PROJECT_NUMBER=
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_SUPABASE_URL=https://auth.example.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_PACKAGE_SIGNING_KEY=
EXPO_PUBLIC_POSTHOG_ENABLED=false
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_ANALYTICS_ENVIRONMENT=production
EXPO_PUBLIC_APP_RELEASE=0.1.0
